# Google Identity Services browser client ID.
# This is intentionally a public OAuth client identifier, not a secret.
VITE_GOOGLE_CLIENT_ID=your_google_web_client_id

# Optional. Leave blank for the recommended same-origin production deployment
# where Express serves client/dist and the API lives at /api on the same host.
# For a split frontend/API deployment, set the API origin only (no /api suffix),
# for example: https://api.example.com
VITE_API_ORIGIN=

DEV_API_TARGET=http://localhost:5000