PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SERVE_CLIENT_BUILD=false
TRUST_PROXY=false
REQUEST_BODY_LIMIT=1mb
HTTP_REQUEST_TIMEOUT_MS=180000
HTTP_KEEP_ALIVE_TIMEOUT_MS=65000
HTTP_HEADERS_TIMEOUT_MS=70000
SHUTDOWN_GRACE_MS=45000
SLOW_REQUEST_LOG_MS=1500

MONGO_URI=your_mongodb_connection_string
MONGO_AUTO_INDEX=true
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000

OTP_SECRET=put_a_long_random_secret_here
PENDING_REGISTRATION_TTL_MINUTES=30

BREVO_API_KEY=your_real_brevo_api_key
BREVO_SENDER_EMAIL=your_verified_brevo_sender_email
BREVO_SENDER_NAME=StudyFluxAI

JWT_SECRET=put_a_long_random_secret_here
JWT_EXPIRES_IN=7d
JWT_COOKIE_DAYS=7

GOOGLE_CLIENT_ID=your_client_id_here

GEMINI_API_KEY=your_gemini_api_key

GEMINI_PRIMARY_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_PRIMARY_TIMEOUT_MS=60000
GEMINI_FALLBACK_TIMEOUT_MS=60000
STUDY_GENERATION_CONCURRENCY=2
STUDY_GENERATION_STALE_MS=300000
STUDY_GENERATION_QUEUE_MAX=50
STUDY_GENERATION_RATE_LIMIT_PER_HOUR=20

GENERATION_FLUXGEM_COST=50
AI_NOTES_FLUXGEM_COST=25
AI_QUIZ_FLUXGEM_COST=25


GOOGLE_FORMS_CLIENT_ID=your_new_client_id
GOOGLE_FORMS_CLIENT_SECRET=your_new_client_secret
GOOGLE_FORMS_REDIRECT_URI=http://localhost:5000/api/integrations/google-forms/callback
GOOGLE_OAUTH_STATE_SECRET=put_a_separate_long_random_secret_here
GOOGLE_TOKEN_ENCRYPTION_KEY=your_random_secret

# AI Tutor
TUTOR_FREE_QUESTIONS_PER_DAY=5
TUTOR_PAID_QUESTION_COST=5
TUTOR_DAILY_HARD_LIMIT=100
TUTOR_RATE_LIMIT_MS=1500
TUTOR_STALE_LOCK_MS=120000
TUTOR_QUESTION_MAX_LENGTH=2000
TUTOR_HISTORY_MESSAGES=12
TUTOR_MAX_OUTPUT_TOKENS=2400
TUTOR_MAX_CONTINUATIONS=2
TUTOR_STUDY_CONTEXT_MAX_CHARS=24000
TUTOR_QUIZ_CONVERSION_COST=25
TUTOR_QUIZ_CONVERSION_TIMEOUT_MS=60000

RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET
RAZORPAY_REQUEST_TIMEOUT_MS=15000

# Community polls / Daily Challenges (optional locally; MongoDB fallback remains active)
REDIS_URL=
REDIS_REQUIRED=false
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_RECONNECT_MS=30000

ADMIN_SEED_NAME=StudyFluxAI Admin
ADMIN_SEED_EMAIL=admin_email
ADMIN_SEED_PASSWORD=YOUR_STRONG_ADMIN_PASSWORD

# Smart Interview voice engine
INTERVIEW_FLUXGEM_COST=100
INTERVIEW_QUESTION_COUNT=8
INTERVIEW_NO_SPEECH_TIMEOUT_MS=15000
INTERVIEW_END_SILENCE_MS=7000
INTERVIEW_MAX_ANSWER_SECONDS=120
INTERVIEW_GEMINI_TIMEOUT_MS=60000
# Defaults to GEMINI_PRIMARY_MODEL / GEMINI_FALLBACK_MODEL when omitted.
# INTERVIEW_GEMINI_MODEL=gemini-3.6-flash
# INTERVIEW_GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
INTERVIEW_TTS_MODEL=gemini-2.5-flash-preview-tts
INTERVIEW_TTS_FALLBACK_MODEL=gemini-3.1-flash-tts-preview
INTERVIEW_TTS_VOICE=Kore
INTERVIEW_TTS_TIMEOUT_MS=20000
INTERVIEW_JOB_POLL_MS=1500
INTERVIEW_JOB_LEASE_MS=180000
INTERVIEW_JOB_CONCURRENCY=2
INTERVIEW_JOB_MAX_ATTEMPTS=3
INTERVIEW_TIMING_LOGS=true
SUPPORT_INBOX_EMAIL=support@example.com

# Study Planner 7-day email reminders (optional tuning)
STUDY_PLAN_REMINDER_POLL_MS=300000
STUDY_PLAN_REMINDER_LEASE_MS=600000
STUDY_PLAN_REMINDER_RETRY_MS=900000
STUDY_PLAN_REMINDER_MAX_ATTEMPTS=5
STUDY_PLAN_REMINDER_BATCH_SIZE=20